{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Post do Blog",
    "description": "Posts do blog publicados via Ascendly (IA) ou manualmente"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "maxLength": 280,
      "description": "Resumo curto pra preview e SEO description (até 280 chars)"
    },
    "content": {
      "type": "blocks",
      "description": "Corpo do post — blocks do Strapi v5 (parágrafos, headings, listas, imagens, código)"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Imagem destacada do post"
    },
    "author": {
      "type": "string",
      "description": "Nome do autor (ex: 'Ascendly AI', 'Marco Souza')"
    },
    "category": {
      "type": "enumeration",
      "enum": ["noticia", "tutorial", "case", "novidade", "tendencia", "geral"],
      "default": "geral"
    },
    "tags": {
      "type": "json",
      "description": "Array de strings (ex: [\"IA\", \"Marketing\", \"SEO\"])"
    },
    "readingTime": {
      "type": "integer",
      "description": "Minutos estimados de leitura (calculado pelo publisher)"
    },
    "source": {
      "type": "enumeration",
      "enum": ["ascendly", "manual"],
      "default": "ascendly",
      "description": "Origem do post — útil pra filtrar/auditar publicações automatizadas"
    },
    "externalId": {
      "type": "string",
      "description": "ID do post no sistema de origem (ex: ID do artigo no Ascendly). Idempotência: publisher checa antes de criar duplicado."
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
