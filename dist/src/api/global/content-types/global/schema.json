{
    "kind": "singleType",
    "collectionName": "globals",
    "info": {
        "singularName": "global",
        "pluralName": "globals",
        "displayName": "Global",
        "description": "Configurações globais do site (header, footer, contato, SEO padrão)"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "siteName": {
            "type": "string",
            "required": true,
            "default": "ProductsM3"
        },
        "tagline": {
            "type": "string"
        },
        "favicon": {
            "type": "media",
            "multiple": false,
            "allowedTypes": ["images"]
        },
        "defaultSeo": {
            "type": "component",
            "repeatable": false,
            "component": "shared.seo"
        },
        "header": {
            "type": "component",
            "repeatable": false,
            "component": "layout.header"
        },
        "footer": {
            "type": "component",
            "repeatable": false,
            "component": "layout.footer"
        },
        "contact": {
            "type": "component",
            "repeatable": false,
            "component": "layout.contact-info"
        }
    }
}
